<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Document types this app can open -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>ARC Lower Thirds Graphics</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.example.arc.ltgfx</string>
                <string>public.json</string>
            </array>
        </dict>
    </array>

    <!-- Exported UTType for .ltgfx files -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.data</string>
            </array>
            <key>UTTypeDescription</key>
            <string>ARC Lower Thirds Graphics</string>
            <key>UTTypeIdentifier</key>
            <string>com.example.arc.ltgfx</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ltgfx</string>
                    <string>ltgfx.json</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/json</string>
                </array>
            </dict>
        </dict>
    </array>

    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.text</string>
            </array>
            <key>UTTypeDescription</key>
            <string>JSON</string>
            <key>UTTypeIdentifier</key>
            <string>public.json</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>json</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/json</string>
                </array>
            </dict>
        </dict>
    </array>

    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>UISupportsDocumentBrowser</key>
    <false/>

    <!-- Local network for HTTP remote control (StreamDeck / Bitfocus Companion) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>ARC Lower Thirds uses the local network for remote control via StreamDeck and Bitfocus Companion.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_arclowerthirds._tcp</string>
    </array>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
</dict>
</plist>
