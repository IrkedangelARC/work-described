    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#121212" android:pathData="M0,0h108v108h-108z" />
    <path android:fillColor="#1C1C1C" android:pathData="M0,0h21.6v108h-21.6z" />
    <path android:fillColor="#242424" android:pathData="M21.6,0h21.6v108h-21.6z" />
    <path android:fillColor="#2C2C2C" android:pathData="M43.2,0h21.6v108h-21.6z" />
    <path android:fillColor="#343434" android:pathData="M64.8,0h21.6v108h-21.6z" />
